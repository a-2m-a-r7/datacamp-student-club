# DataCamp Student Club - Environment Variables Example
# ----------------------------------------------------------------------------
# Google Gemini API Key (Serverless API only - https://aistudio.google.com/apikey)
# SERVER ONLY. Used by /api/ai/chat.ts proxy without exposing to browser.
GEMINI_API_KEY=

# Supabase Configuration (from https://supabase.com/dashboard/project/_/settings/api):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional server aliases; leave blank to use the VITE_ URL/public-key values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Enable only after provisioning Realtime capacity for the intended concurrency.
# Default: visible-tab polling every 60–75 seconds; writes refresh immediately.
VITE_ENABLE_REALTIME=false
# Optional public URL for an independently hosted Piston execution endpoint.
# Leave empty until deployed. Never put authorization tokens in VITE_* or this URL.
VITE_PISTON_API_URL=

# Supabase server/admin configuration:
# SERVER ONLY. Never expose this as VITE_* and never use it in browser code.
# Needed for secure serverless admin user operations (/api/admin/users.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical production domain for QR codes, verification links, and shares
VITE_SITE_URL=http://127.0.0.1:3000

# App URLs used by Supabase Auth redirect settings.
VITE_APP_URL=http://127.0.0.1:3000
VITE_AUTH_REDIRECT_URL=http://127.0.0.1:3000/auth/callback
# Optional server canonical override; Drive redirects must match it exactly.
COURSE_SITE_URL=
# Optional local development HMR switch.
DISABLE_HMR=false

# First-admin setup for a NEW project is a deliberate owner SQL operation.
# Follow README.md after the real account has confirmed its email.

# ----------------------------------------------------------------------------
# Google Sheets & Google Drive Integration (Serverless API only)
# SERVER ONLY. Never prefix with VITE_* and never use in browser client code.
# Used by /api/forms/sync-sheet.ts for automatic form syncing with Google Sheets.
# ----------------------------------------------------------------------------
# Leave optional Google integration empty until genuine credentials and
# spreadsheet access are configured. Never use an example key or recipient.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_OWNER_EMAIL=

# Course uploads: dedicated Web OAuth client; server only, drive.file scope.
# Redirect: https://YOUR_SITE/api/courses/drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Enable only after confirming the project's Gemini free-tier configuration.
GEMINI_COURSE_ENABLED=false
GEMINI_COURSE_MODEL=gemini-2.5-flash

