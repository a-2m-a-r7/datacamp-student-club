# DataCamp Student Club - Environment Variables Example
# ----------------------------------------------------------------------------
# Google Gemini API Key (Get a free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration:
# Already pre-configured for DataCamp Club via firebase-applet-config.json.
# (Optional) reCAPTCHA v3 site key for production App Check:
# VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
