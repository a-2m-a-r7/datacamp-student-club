# DataCamp Student Club - Environment Variables Example
# ----------------------------------------------------------------------------
# Google Gemini API Key (Get a free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (from https://supabase.com/dashboard/project/_/settings/api):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase server/admin configuration:
# SERVER ONLY. Never expose this as VITE_* and never use it in browser code.
# Needed later only for secure server-side admin operations or Supabase Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here

# App URLs used by Supabase Auth redirect settings.
VITE_APP_URL=http://localhost:3000
VITE_AUTH_REDIRECT_URL=http://localhost:3000/dashboard

# Admin bootstrap:
# Add the real admin email in Supabase SQL after migrations:
# SELECT public.promote_admin_by_email('admin@example.com');
ADMIN_EMAILS=admin@example.com

# Firebase Configuration:
# Already pre-configured for DataCamp Club via firebase-applet-config.json.
# (Optional) reCAPTCHA v3 site key for production App Check:
# VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
